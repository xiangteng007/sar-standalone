[Unit]
Description=SAR private standalone service
After=network.target
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=exec
User=sar
Group=sar
WorkingDirectory=/opt/sar/current
Environment=SAR_BIND=127.0.0.1
Environment=SAR_PORT=8787
Environment=SAR_DATA_DIR=/var/lib/sar/data
ExecStartPre=/opt/sar/node/bin/node --env-file=/etc/sar/sar.env /opt/sar/current/server.mjs --check-config
ExecStart=/opt/sar/node/bin/node --env-file=/etc/sar/sar.env /opt/sar/current/server.mjs
Restart=on-failure
RestartSec=10
TimeoutStopSec=60
KillSignal=SIGTERM
KillMode=control-group
UMask=0077
StateDirectory=sar
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
